generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Deal {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  image         String?
  originalPrice Float?
  dealPrice     Float?
  currency      String    @default("INR")
  discount      Int?
  store         String?
  dealUrl       String
  category      String?
  dealScore     Int       @default(0)
  verified      Boolean   @default(false)
  status        String    @default("PENDING")
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Trial {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  image           String?
  category        String?
  trialDays       Int?
  priceAfterTrial Float?
  currency        String    @default("INR")
  cardRequired    Boolean   @default(false)
  autoRenew       Boolean   @default(false)
  officialUrl     String
  verified        Boolean   @default(false)
  status          String    @default("PENDING")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
